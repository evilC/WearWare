@page "/buttons"
@rendermode InteractiveServer
@implements IDisposable
@using WearWare.Services.Button
@using WearWare.Services.Mode
@inject ButtonManager ButtonManager
@inject ButtonFunctionMappingService MappingService
@inject ModeHandler ModeHandler
@inject ILogger<Buttons> Logger

<PageTitle>WearWare Buttons</PageTitle>

<h1>Buttons</h1>

<p class="text-muted">Changing a QuickMedia button's function deletes its QuickMedia item and files.</p>

@if (_error is not null)
{
    <div class="alert alert-warning" role="alert">@_error</div>
}

@if (ButtonManager.Provider == null)
{
    <div class="alert alert-info" role="alert">
        No button provider configured. Buttons are disabled.
    </div>
}
else
{
    <p class="text-muted mb-3">
        Provider: <strong>@_providerName</strong>
    </p>

    @if (!_buttons.Any())
    {
        <div class="alert alert-info" role="alert">
            Button provider configured but no buttons are assigned.
        </div>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th style="width: 80px;">Button</th>
                    <th style="width: 120px;">Physical Pin</th>
                    <th>Function</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < _buttons.Count; i++)
                {
                    var button = _buttons[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td><code>@button.PinName</code></td>
                        <td>
                            <select @key="(button.PinName, _revision)" class="form-select" value="@(_functions[button.PinName])" disabled="@_saving"
                                    @onchange="@((ChangeEventArgs e) => OnFunctionChanged(button.PinName, e.Value?.ToString() ?? ""))">
                                <option value="None">None</option>
                                <option value="QuickMedia">QuickMedia</option>
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private List<ButtonInfo> _buttons = [];
    private Dictionary<string, string> _functions = [];
    private string _providerName = "";
    private bool _saving;
    private string? _error;
    private int _revision;

    protected override void OnInitialized()
    {
        _buttons = ButtonManager.GetAllButtons().ToList();
        MappingService.StateChanged += OnMappingsChanged;
        UpdateFunctions();
        _providerName = GetProviderName();
    }

    private void UpdateFunctions()
    {
        foreach (var button in _buttons)
            _functions[button.PinName] = MappingService.GetFunctionForPin(button.PinName);
    }

    private void OnMappingsChanged()
    {
        _ = InvokeAsync(() =>
        {
            UpdateFunctions();
            StateHasChanged();
        });
    }

    private string GetProviderName()
    {
        var provider = ButtonManager.Provider;
        if (provider == null)
        {
            return "None";
        }

        var typeName = provider.GetType().Name;
        return typeName switch
        {
            "PiGpioButtonProvider" => "Raspberry Pi GPIO",
            "Mcp23017ButtonProvider" => "MCP23017 I2C Expander",
            _ => typeName
        };
    }

    private async Task OnFunctionChanged(string pinName, string function)
    {
        if (_saving)
        {
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            await ModeHandler.SetButtonFunctionAsync(pinName, function);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not update button function for {pinName}.", pinName);
            _error = ex is InvalidOperationException ? ex.Message : "Could not complete the button function change. See the log for details.";
        }
        finally
        {
            UpdateFunctions();
            _revision++;
            _saving = false;
        }
    }

    public void Dispose() => MappingService.StateChanged -= OnMappingsChanged;
}
