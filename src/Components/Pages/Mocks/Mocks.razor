@page "/mocks"
@rendermode InteractiveServer

<PageTitle>WareWare Mocks</PageTitle>

<p>Mock QuickMedia buttons are temporarily unavailable.</p>

@* Mock buttons UI:
<link href="/src/Components/Pages/Mocks/Mocks.razor.css" rel="stylesheet" />

@if (!Ready)
{
	<LoadingOverlay />
}
else if (QuickMediaManager.GetButtonCount() == 0)
{
    <p>No quick-media buttons available.</p>
}
else
{
    <h2>Mock Quick Media Buttons</h2>
    <div class="qm-button-instructions">Clicking images simulates pressing the corresponding QuickMedia button on the Pi.</div>
    <div class="qm-button-list">
        @for (int i = 0; i < QuickMediaManager.GetButtonCount(); i++)
        {
            var button = QuickMediaManager.GetButtonItem(i);
            var index = i;
            <div class="qm-button-item" @onclick="() => OnButtonClick(index)" style="cursor: pointer;">
                <span class="qm-button-title">B@(i + 1)</span>
                @if (button is not null)
                {
                    <PlayableItemCard 
                        ImageSrc="@($"/quickmedia-images/{index}/{button.SourceFileName}")" 
                        Item="@button" 
                        />
                }
            </div>
        }
    </div>
}
*@
