@page "/mode"
@rendermode InteractiveServer
@implements IDisposable
@using WearWare.Architecture.Mode
@inject ModeHandler ModeHandler

<PageTitle>WearWare Mode</PageTitle>

<h1>Mode</h1>

<p>Current mode: <strong>@ModeHandler.State.Mode</strong></p>

<div class="d-flex gap-2 mb-3">
    <button class="btn @(ModeHandler.State.Mode == DisplayMode.Playlist ? "btn-primary" : "btn-outline-primary")"
            disabled="@(_changing || (ModeHandler.State.Mode == DisplayMode.Playlist && ModeHandler.State.PreferredMode == DisplayMode.Playlist))"
            @onclick="() => ChangeMode(DisplayMode.Playlist)">Playlist</button>
    <button class="btn @(ModeHandler.State.Mode == DisplayMode.QuickMedia ? "btn-primary" : "btn-outline-primary")"
            disabled="@(_changing || (ModeHandler.State.Mode == DisplayMode.QuickMedia && ModeHandler.State.PreferredMode == DisplayMode.QuickMedia))"
            @onclick="() => ChangeMode(DisplayMode.QuickMedia)">QuickMedia</button>
    <button class="btn @(ModeHandler.State.Mode == DisplayMode.Physics ? "btn-primary" : "btn-outline-primary")"
            disabled="@(_changing || (ModeHandler.State.Mode == DisplayMode.Physics && ModeHandler.State.PreferredMode == DisplayMode.Physics))"
            @onclick="() => ChangeMode(DisplayMode.Physics)">Physics (Fluid)</button>
</div>

@if (ModeHandler.State.Mode != ModeHandler.State.PreferredMode)
{
    <p>Saved mode: @ModeHandler.State.PreferredMode (will be retried on startup).</p>
}

@if (ModeHandler.State.Message is { } message)
{
    <div class="alert alert-warning" role="alert">@message</div>
}

@code {
    private bool _changing;

    protected override void OnInitialized()
    {
        ModeHandler.StateChanged += OnStateChanged;
    }

    private void OnStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ChangeMode(DisplayMode mode)
    {
        _changing = true;
        try
        {
            await ModeHandler.SetModeAsync(mode);
        }
        finally
        {
            _changing = false;
        }
    }

    public void Dispose()
    {
        ModeHandler.StateChanged -= OnStateChanged;
    }
}
