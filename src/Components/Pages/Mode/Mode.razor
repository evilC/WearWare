@page "/mode"
@rendermode InteractiveServer
@implements IDisposable
@using WearWare.Services.Mode
@inject ModeHandler ModeHandler

<PageTitle>WearWare Mode</PageTitle>

<h1>Mode</h1>

<p>Current mode: <strong>@ModeHandler.State.CurrentMode</strong></p>
@if (ModeHandler.State.InterruptingMode is { } interruptingMode)
{
    <p>Interrupting mode: <strong>@interruptingMode</strong></p>
}

<div class="d-flex gap-2 mb-3">
    <button class="btn @(ModeHandler.State.CurrentMode == DisplayMode.Playlist ? "btn-primary" : "btn-outline-primary")"
            disabled="@(_changing || (ModeHandler.State.CurrentMode == DisplayMode.Playlist && (ModeHandler.State.InterruptingMode != null || ModeHandler.State.ActiveMode == DisplayMode.Playlist)))"
            @onclick="() => ChangeMode(DisplayMode.Playlist)">Playlist</button>
    <button class="btn @(ModeHandler.State.CurrentMode == DisplayMode.Physics ? "btn-primary" : "btn-outline-primary")"
            disabled="@(_changing || (ModeHandler.State.CurrentMode == DisplayMode.Physics && (ModeHandler.State.InterruptingMode != null || ModeHandler.State.ActiveMode == DisplayMode.Physics)))"
            @onclick="() => ChangeMode(DisplayMode.Physics)">Physics (Fluid)</button>
</div>

@if (ModeHandler.State.InterruptingMode == null && ModeHandler.State.ActiveMode != ModeHandler.State.CurrentMode)
{
    <p>Active mode: @ModeHandler.State.ActiveMode (the selected mode will be retried on startup).</p>
}

@if (ModeHandler.State.Message is { } message)
{
    <div class="alert alert-warning" role="alert">@message</div>
}

@code {
    private bool _changing;

    protected override void OnInitialized()
    {
        ModeHandler.StateChanged += OnStateChanged;
    }

    private void OnStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ChangeMode(DisplayMode mode)
    {
        _changing = true;
        try
        {
            await ModeHandler.SetModeAsync(mode);
        }
        finally
        {
            _changing = false;
        }
    }

    public void Dispose()
    {
        ModeHandler.StateChanged -= OnStateChanged;
    }
}
