@page "/physics"
@rendermode InteractiveServer
@implements IDisposable
@using WearWare.Services.Mode
@using WearWare.Services.Physics
@using WearWare.Services.Physics.Imu
@using System.Numerics
@inject PhysicsHandler PhysicsHandler
@inject ModeHandler ModeHandler
@inject ImuService Imu

<PageTitle>WearWare Physics</PageTitle>

<h1>Physics</h1>

@if (PhysicsHandler.SelectionMessage is { } selectionMessage)
{
    <div class="alert alert-warning" role="alert">@selectionMessage</div>
}
@if (ModeHandler.State.Message is { } modeMessage)
{
    <div class="alert alert-warning" role="alert">@modeMessage</div>
}

<h2>Simulations</h2>
<p>Select the simulation to run in Physics mode. Check simulations to include them in physical Next/Previous button navigation.</p>
<div class="list-group" aria-label="Physics simulations">
    @foreach (var simulation in PhysicsHandler.Simulations)
    {
        <div class="d-flex align-items-center gap-2">
            <input type="checkbox" class="ww-large-checkbox flex-shrink-0" aria-label="Include @simulation in button navigation"
                   disabled="@_changing" @bind:get="PhysicsHandler.IsJogEnabled(simulation)"
                   @bind:set="(bool enabled) => SetJogEnabled(simulation, enabled)" />
            <button type="button" class="list-group-item list-group-item-action flex-grow-1 w-auto @(simulation == PhysicsHandler.SelectedSimulation ? "active" : "")"
                    aria-pressed="@(simulation == PhysicsHandler.SelectedSimulation)"
                    disabled="@_changing" @onclick="() => SelectSimulation(simulation)">@simulation</button>
        </div>
    }
</div>

<section class="mt-3" aria-labelledby="physics-imu">
    <h2 id="physics-imu">IMU</h2>
    <p>Reset the IMU connection if motion sensing stops. If readings resume, Physics will be selected and the current simulation will start after any QuickMedia interruption.</p>
    <button type="button" class="btn btn-secondary" disabled="@_resettingImu" @onclick="ResetImu">Reset IMU</button>
    @if (_imuResetMessage is not null)
    {
        <div class="alert @(_imuResetSuccess ? "alert-success" : "alert-warning") mt-2" role="status">@_imuResetMessage</div>
    }
</section>

<section class="mt-3" aria-labelledby="physics-calibration">
    <h2 id="physics-calibration">Calibration</h2>
    @if (Imu.CalibrationWarning is { } calibrationWarning)
    {
        <div class="alert alert-warning" role="alert">@calibrationWarning</div>
    }
    <p>Hold the shirt upright and still for a second, then calibrate its alignment. This does not stop the simulation.</p>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-primary" @onclick="CalibrateAlignment">Calibrate IMU</button>
        <button type="button" class="btn btn-secondary" @onclick="ResetAlignment">Reset IMU calibration</button>
    </div>
    @if (_calibrationMessage is not null)
    {
        <div class="alert @(_calibrationSuccess ? "alert-success" : "alert-warning") mt-2" role="status">@_calibrationMessage</div>
    }
</section>

<section class="mt-3" aria-labelledby="physics-configuration">
    <h2 id="physics-configuration">Configuration</h2>
    <h3>IMU orientation</h3>
    <p>Current orientation: @(Imu.Orientation is { } orientation ? OrientationLabel(orientation) : "Unavailable")</p>
    <label for="imu-orientation" class="form-label">Mounting orientation</label>
    <select id="imu-orientation" class="form-select mb-2" @bind="SelectedOrientation" disabled="@(Imu.Orientation == null || _detectionStep != DetectionStep.None)">
        @foreach (var option in Enum.GetValues<ImuOrientation>())
        {
            <option value="@option">@OrientationLabel(option)</option>
        }
    </select>
    <div class="alert @(_orientationMessage is null ? "alert-info" : _orientationSuccess ? "alert-success" : "alert-warning") mb-2"
         role="status" style="height: 11rem; overflow-y: auto;">
        @if (_detectionStep != DetectionStep.None)
        {
            <p class="mb-0">@DetectionInstruction</p>
        }
        @if (_orientationMessage is not null)
        {
            <p class="@(_detectionStep != DetectionStep.None ? "mt-2 mb-0" : "mb-0")">@_orientationMessage</p>
        }
        else if (_detectionStep == DetectionStep.None)
        {
            <p class="mb-0">Select an orientation or use detection to find it.</p>
        }
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (_detectionStep == DetectionStep.None)
        {
            <button type="button" class="btn btn-primary" @onclick="ApplyOrientation" disabled="@(Imu.Orientation == null)">Apply orientation</button>
            <button type="button" class="btn btn-secondary" @onclick="StartDetection">Detect orientation</button>
        }
        else
        {
            <button type="button" class="btn btn-primary" @onclick="CaptureDetection">Continue</button>
            <button type="button" class="btn btn-secondary" @onclick="CancelDetection">Cancel</button>
        }
    </div>
</section>

@code {
    private bool _changing;
    private bool _resettingImu;
    private bool _imuResetSuccess;
    private string? _imuResetMessage;
    private bool _calibrationSuccess;
    private string? _calibrationMessage;
    private ImuOrientation _selectedOrientation;
    private bool _orientationDirty;
    private bool _orientationSuccess;
    private string? _orientationMessage;
    private DetectionStep _detectionStep;
    private Vector3 _uprightReading;
    private Vector3 _rightReading;

    private enum DetectionStep { None, Upright, Right, Left }

    private ImuOrientation SelectedOrientation
    {
        get => _selectedOrientation;
        set
        {
            _selectedOrientation = value;
            _orientationDirty = true;
            _orientationMessage = null;
        }
    }

    private string DetectionInstruction => _detectionStep switch
    {
        DetectionStep.Upright => "Hold the shirt upright and still for a second, then press Continue.",
        DetectionStep.Right => "From the front of the display, tilt its top to the right. Hold still for a second, then press Continue.",
        DetectionStep.Left => "The result is unclear. Tilt the top to the left instead, hold still for a second, then press Continue.",
        _ => string.Empty
    };

    private static string OrientationLabel(ImuOrientation orientation) => orientation switch
    {
        ImuOrientation.Default => "Default (X+, Y+, Z+)",
        ImuOrientation.RotateX => "180 degrees around X (X+, Y-, Z-)",
        ImuOrientation.RotateY => "180 degrees around Y (X-, Y+, Z-)",
        ImuOrientation.RotateZ => "180 degrees around Z (X-, Y-, Z+)",
        _ => throw new ArgumentOutOfRangeException(nameof(orientation))
    };

    private void ApplyOrientation()
    {
        var changed = Imu.Orientation != _selectedOrientation;
        (_orientationSuccess, _orientationMessage) = Imu.SetOrientation(_selectedOrientation);
        if (_orientationSuccess)
        {
            _orientationDirty = false;
            if (changed)
                _calibrationMessage = null;
        }
    }

    private void StartDetection()
    {
        _orientationMessage = null;
        _detectionStep = DetectionStep.Upright;
    }

    private void CancelDetection()
    {
        _detectionStep = DetectionStep.None;
        _orientationMessage = null;
    }

    private void CaptureDetection()
    {
        var (success, message, reading) = Imu.GetStationaryAcceleration();
        if (!success)
        {
            _orientationSuccess = false;
            _orientationMessage = message;
            return;
        }
        _orientationMessage = null;
        if (_detectionStep == DetectionStep.Upright)
        {
            _uprightReading = reading;
            _detectionStep = DetectionStep.Right;
            return;
        }
        if (_detectionStep == DetectionStep.Right)
            _rightReading = reading;

        var (status, orientation) = ImuOrientationDetection.Detect(
            _uprightReading, _rightReading, _detectionStep == DetectionStep.Left ? reading : null);
        switch (status)
        {
            case OrientationDetectionStatus.Detected:
                _selectedOrientation = orientation;
                _orientationDirty = true;
                _orientationSuccess = true;
                _orientationMessage = "Orientation detected. Review the selection and press Apply orientation.";
                _detectionStep = DetectionStep.None;
                break;
            case OrientationDetectionStatus.Unsupported:
                _orientationSuccess = false;
                _orientationMessage = "Unsupported orientation detected. 90-degree rotations are not supported. The existing orientation has not changed.";
                _detectionStep = DetectionStep.None;
                break;
            case OrientationDetectionStatus.NeedLeftTilt:
                _detectionStep = DetectionStep.Left;
                break;
            case OrientationDetectionStatus.Retry:
                _orientationSuccess = false;
                _orientationMessage = "Could not determine orientation. Hold the shirt upright and try again.";
                _detectionStep = DetectionStep.None;
                break;
        }
    }

    private void CalibrateAlignment() => (_calibrationSuccess, _calibrationMessage) = Imu.CalibrateAlignment();

    private void ResetAlignment() => (_calibrationSuccess, _calibrationMessage) = Imu.ResetAlignment();

    private async Task ResetImu()
    {
        _resettingImu = true;
        _imuResetMessage = "Resetting IMU...";
        try
        {
            (_imuResetSuccess, _imuResetMessage) = await Imu.ResetAsync();
            if (!_imuResetSuccess)
                return;

            await ModeHandler.SetModeAsync(DisplayMode.Physics);
            if (ModeHandler.State.InterruptingMode != null && ModeHandler.State.CurrentMode == DisplayMode.Physics)
                _imuResetMessage = "IMU reset. Physics will start after QuickMedia.";
            else if (ModeHandler.State.ActiveMode == DisplayMode.Physics)
                _imuResetMessage = "IMU reset. Physics started.";
            else
            {
                _imuResetSuccess = false;
                _imuResetMessage = "IMU reset, but Physics could not start. See the mode message and log.";
            }
        }
        finally
        {
            _resettingImu = false;
        }
    }

    protected override void OnInitialized()
    {
        Imu.OrientationChanged += OnOrientationChanged;
        _selectedOrientation = Imu.Orientation ?? ImuOrientation.Default;
        PhysicsHandler.StateChanged += OnStateChanged;
        ModeHandler.StateChanged += OnStateChanged;
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnOrientationChanged() => _ = InvokeAsync(() =>
    {
        if (!_orientationDirty && Imu.Orientation is { } orientation)
            _selectedOrientation = orientation;
        _calibrationMessage = null;
        StateHasChanged();
    });

    private async Task SelectSimulation(string simulation)
    {
        _changing = true;
        try
        {
            await ModeHandler.SelectPhysicsSimulationAsync(simulation);
        }
        finally
        {
            _changing = false;
        }
    }

    private async Task SetJogEnabled(string simulation, bool enabled)
    {
        _changing = true;
        try
        {
            await ModeHandler.SetPhysicsJogEnabledAsync(simulation, enabled);
        }
        finally
        {
            _changing = false;
        }
    }

    public void Dispose()
    {
        PhysicsHandler.StateChanged -= OnStateChanged;
        ModeHandler.StateChanged -= OnStateChanged;
        Imu.OrientationChanged -= OnOrientationChanged;
    }
}
