@page "/quickmedia"
@inherits DataPageBase
@rendermode InteractiveServer

<PageTitle>WareWare QuickMedia</PageTitle>

@if (!Ready)
{
	<LoadingOverlay />
}

@if (_addFormModel is not null)
{
	@* Add QuickMedia item dialog*@
	<AddPlayableItemForm 
		LibraryItems="_libraryItems"
		FormModel="_addFormModel"
		PageTitle="@($" Adding QuickMedia B{_addFormModel.ItemIndex+1}")"
		OnCancel="OnAddDialogCancel"
		OnAdd="OnAddDialogItemChosen"
	/>
}
else if(_editFormModel is not null)
{
	@* Edit PlayableItem dialog*@
	<EditPlayableItemForm
		FormModel="_editFormModel"
		OnSave="OnSaveQuickMediaItem"
		OnCancel="OnEditFormCancel"
		ZIndex="2000"
	/>
}

@* Regular QuickMedia view *@
@if (_quickMediaItems is null || _quickMediaItems.Count == 0)
{
	<p>No quick-media buttons available.</p>
}
else
{
	<div class="d-flex flex-column">
		@for (int i = 0; i < _quickMediaItems.Count; i++)
		{
			var item = _quickMediaItems[i];
			var buttonNumber = _quickMediaButtonNumbers[i];
			var index = i;
			<div class="col-12 mb-3">
				<div class="card h-100 shadow-sm bg-light">
					<div class="card-body p-0">
						<div class="d-flex align-items-center gap-3 p-2">
							<div class="d-flex align-items-center">
								<span class="text-7">B@(buttonNumber)</span>
							</div>
							<div class="d-flex flex-column justify-content-between me-2 gap-2">
								@if (item is null)
								{
									<button class="btn btn-sm btn-outline-primary" @onclick="() => OnAddDialogShow(buttonNumber)">Add</button>
								}
								else
								{    
									<button class="btn btn-sm btn-outline-primary" @onclick="() => OnEditQuickMediaItem(item, buttonNumber)">Edit</button>
								}
								@if (item is not null)
								{
									<button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDeleteQuickMediaButton(buttonNumber)">Delete</button>
								}
							</div>
							@if (item is not null)
							{
								<div class="flex-grow-1">
									<PlayableItemCard
										ImageSrc="@($"/quickmedia-images/{buttonNumber}/{item.SourceFileName}")"
										FormPage="EditPlayableItemFormPage.QuickMedia"
										FormMode="EditPlayableItemFormMode.Edit"
										Item="item"
									/>
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		}
	</div>
}
